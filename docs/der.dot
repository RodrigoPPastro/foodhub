digraph DER {
graph [rankdir=TB, splines=ortho, nodesep=0.5, ranksep=1.1, fontname="Helvetica", bgcolor="white", pad=0.4, label="FOOD HUB — Diagrama Entidade-Relacionamento (gerado do script SQL)", labelloc=t, fontsize=22];
node [shape=plaintext, fontname="Helvetica", fontsize=11];
edge [arrowhead=none, color="#555555", fontname="Helvetica", fontsize=9];
autenticacao_2fa [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF7E3" color="#333333"><tr><td bgcolor="#F2A900" align="center"><font color="black"><b>AUTENTICACAO_2FA</b></font></td></tr><tr><td align="left"><b>id_2fa (PK)</b></td></tr><tr><td align="left"><i>id_usuario (FK)</i></td></tr><tr><td align="left">pergunta (3 perguntas de segurança)</td></tr><tr><td align="left">resposta_hash</td></tr></table>>];
canal_venda [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5F1" color="#333333"><tr><td bgcolor="#2A9D8F" align="center"><font color="white"><b>CANAL_VENDA</b></font></td></tr><tr><td align="left"><b>codigo (PK)</b></td></tr><tr><td align="left">rotulo</td></tr><tr><td align="left">presencial</td></tr><tr><td align="left">externo</td></tr><tr><td align="left">ativo</td></tr><tr><td align="left">comissao_percentual</td></tr><tr><td align="left">prazo_repasse_dias</td></tr></table>>];
categoria [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FDECEC" color="#333333"><tr><td bgcolor="#E63946" align="center"><font color="white"><b>CATEGORIA</b></font></td></tr><tr><td align="left"><b>id_categoria (PK)</b></td></tr><tr><td align="left">nome</td></tr><tr><td align="left">descricao</td></tr></table>>];
conta_financeira [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#EEEAF6" color="#333333"><tr><td bgcolor="#5E548E" align="center"><font color="white"><b>CONTA_FINANCEIRA</b></font></td></tr><tr><td align="left"><b>id_conta (PK)</b></td></tr><tr><td align="left">tipo (pagar/receber)</td></tr><tr><td align="left">descricao</td></tr><tr><td align="left">categoria</td></tr><tr><td align="left">pessoa</td></tr><tr><td align="left">valor</td></tr><tr><td align="left">valor_bruto</td></tr><tr><td align="left">comissao_percentual</td></tr><tr><td align="left">data_emissao</td></tr><tr><td align="left">data_vencimento</td></tr><tr><td align="left">data_baixa</td></tr><tr><td align="left">status (aberta/baixada/cancelada)</td></tr><tr><td align="left"><i>id_pedido (FK, nulo)</i></td></tr><tr><td align="left"><i>id_usuario_baixa (FK, nulo)</i></td></tr><tr><td align="left">observacao</td></tr></table>>];
entregador [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5F1" color="#333333"><tr><td bgcolor="#2A9D8F" align="center"><font color="white"><b>ENTREGADOR</b></font></td></tr><tr><td align="left"><b>id_entregador (PK)</b></td></tr><tr><td align="left">nome</td></tr><tr><td align="left">telefone</td></tr><tr><td align="left">veiculo</td></tr><tr><td align="left">status (disponivel/em_rota/inativo)</td></tr></table>>];
fechamento_caixa [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#EEEAF6" color="#333333"><tr><td bgcolor="#5E548E" align="center"><font color="white"><b>FECHAMENTO_CAIXA</b></font></td></tr><tr><td align="left"><b>id_fechamento (PK)</b></td></tr><tr><td align="left"><i>id_usuario_responsavel (FK, nulo)</i></td></tr><tr><td align="left">data_referencia</td></tr><tr><td align="left">total_vendas</td></tr><tr><td align="left">total_dinheiro</td></tr><tr><td align="left">total_cartao</td></tr><tr><td align="left">total_pix</td></tr><tr><td align="left">total_delivery</td></tr><tr><td align="left">observacoes</td></tr><tr><td align="left">detalhamento</td></tr></table>>];
forma_pagamento [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#EEEAF6" color="#333333"><tr><td bgcolor="#5E548E" align="center"><font color="white"><b>FORMA_PAGAMENTO</b></font></td></tr><tr><td align="left"><b>id_forma_pagamento (PK)</b></td></tr><tr><td align="left">descricao</td></tr></table>>];
insumo [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FDECEC" color="#333333"><tr><td bgcolor="#E63946" align="center"><font color="white"><b>INSUMO</b></font></td></tr><tr><td align="left"><b>id_insumo (PK)</b></td></tr><tr><td align="left">nome</td></tr><tr><td align="left">unidade_medida</td></tr><tr><td align="left">estoque_atual</td></tr><tr><td align="left">estoque_minimo</td></tr><tr><td align="left">custo_unitario</td></tr></table>>];
item_pedido [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5F1" color="#333333"><tr><td bgcolor="#2A9D8F" align="center"><font color="white"><b>ITEM_PEDIDO</b></font></td></tr><tr><td align="left"><b>id_item (PK)</b></td></tr><tr><td align="left"><i>id_pedido (FK)</i></td></tr><tr><td align="left"><i>id_produto (FK)</i></td></tr><tr><td align="left">quantidade</td></tr><tr><td align="left">preco_unitario</td></tr><tr><td align="left">observacao</td></tr><tr><td align="left">setor_preparo (cozinha/bar/nenhum)</td></tr><tr><td align="left">status_item (aguardando/em preparo/pronto/entregue)</td></tr><tr><td align="left">data_hora_inicio_preparo</td></tr></table>>];
log_acesso [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF7E3" color="#333333"><tr><td bgcolor="#F2A900" align="center"><font color="black"><b>LOG_ACESSO</b></font></td></tr><tr><td align="left"><b>id_log (PK)</b></td></tr><tr><td align="left"><i>id_usuario (FK)</i></td></tr><tr><td align="left">data_hora</td></tr><tr><td align="left">tipo_2fa_utilizado</td></tr><tr><td align="left">resultado (sucesso/falha)</td></tr></table>>];
mesa [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5F1" color="#333333"><tr><td bgcolor="#2A9D8F" align="center"><font color="white"><b>MESA</b></font></td></tr><tr><td align="left"><b>id_mesa (PK)</b></td></tr><tr><td align="left">numero</td></tr><tr><td align="left">capacidade</td></tr><tr><td align="left">status (livre/ocupada)</td></tr></table>>];
movimento_estoque [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FDECEC" color="#333333"><tr><td bgcolor="#E63946" align="center"><font color="white"><b>MOVIMENTO_ESTOQUE</b></font></td></tr><tr><td align="left"><b>id_movimento (PK)</b></td></tr><tr><td align="left"><i>id_insumo (FK)</i></td></tr><tr><td align="left"><i>id_usuario (FK, nulo)</i></td></tr><tr><td align="left">tipo (entrada/saida/perda)</td></tr><tr><td align="left">quantidade</td></tr><tr><td align="left">data_hora</td></tr><tr><td align="left">motivo</td></tr></table>>];
notificacao_cliente [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5F1" color="#333333"><tr><td bgcolor="#2A9D8F" align="center"><font color="white"><b>NOTIFICACAO_CLIENTE</b></font></td></tr><tr><td align="left"><b>id_notificacao (PK)</b></td></tr><tr><td align="left"><i>id_pedido (FK)</i></td></tr><tr><td align="left">tipo (confirmacao/atraso/pronto)</td></tr><tr><td align="left">canal</td></tr><tr><td align="left">mensagem</td></tr><tr><td align="left">data_hora_envio</td></tr><tr><td align="left">status_envio (enviado/simulado/falha)</td></tr></table>>];
pagamento [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#EEEAF6" color="#333333"><tr><td bgcolor="#5E548E" align="center"><font color="white"><b>PAGAMENTO</b></font></td></tr><tr><td align="left"><b>id_pagamento (PK)</b></td></tr><tr><td align="left"><i>id_pedido (FK)</i></td></tr><tr><td align="left"><i>id_forma_pagamento (FK)</i></td></tr><tr><td align="left">valor</td></tr><tr><td align="left">data_hora</td></tr></table>>];
pedido [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#E8F5F1" color="#333333"><tr><td bgcolor="#2A9D8F" align="center"><font color="white"><b>PEDIDO</b></font></td></tr><tr><td align="left"><b>id_pedido (PK)</b></td></tr><tr><td align="left"><i>id_usuario_cliente (FK, nulo)</i></td></tr><tr><td align="left"><i>id_entregador (FK, nulo)</i></td></tr><tr><td align="left"><i>id_mesa (FK, nulo)</i></td></tr><tr><td align="left">data_hora</td></tr><tr><td align="left">data_hora_inicio_preparo</td></tr><tr><td align="left"><i>canal (FK)</i></td></tr><tr><td align="left">status (novo/em preparo/pronto/saiu/entregue/cancelado)</td></tr><tr><td align="left">plataforma_externa</td></tr><tr><td align="left">id_pedido_externo</td></tr><tr><td align="left">sincronizado_status_externo</td></tr><tr><td align="left">valor_total</td></tr><tr><td align="left">nome_cliente</td></tr><tr><td align="left">telefone_cliente</td></tr><tr><td align="left">endereco_entrega</td></tr><tr><td align="left">observacao</td></tr><tr><td align="left">estoque_baixado</td></tr></table>>];
produto [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FDECEC" color="#333333"><tr><td bgcolor="#E63946" align="center"><font color="white"><b>PRODUTO</b></font></td></tr><tr><td align="left"><b>id_produto (PK)</b></td></tr><tr><td align="left"><i>id_categoria (FK)</i></td></tr><tr><td align="left">nome</td></tr><tr><td align="left">descricao</td></tr><tr><td align="left">foto</td></tr><tr><td align="left">preco_venda</td></tr><tr><td align="left">ativo</td></tr><tr><td align="left">setor_preparo (cozinha/bar/nenhum)</td></tr></table>>];
produto_insumo [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FDECEC" color="#333333"><tr><td bgcolor="#E63946" align="center"><font color="white"><b>PRODUTO_INSUMO (ficha técnica)</b></font></td></tr><tr><td align="left"><b>id_produto (PK,FK)</b></td></tr><tr><td align="left"><b>id_insumo (PK,FK)</b></td></tr><tr><td align="left">quantidade_utilizada</td></tr></table>>];
usuario [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF7E3" color="#333333"><tr><td bgcolor="#F2A900" align="center"><font color="black"><b>USUARIO</b></font></td></tr><tr><td align="left"><b>id_usuario (PK)</b></td></tr><tr><td align="left">nome_completo</td></tr><tr><td align="left">data_nascimento</td></tr><tr><td align="left">sexo</td></tr><tr><td align="left">nome_materno</td></tr><tr><td align="left">cpf</td></tr><tr><td align="left">email</td></tr><tr><td align="left">telefone_celular</td></tr><tr><td align="left">telefone_fixo</td></tr><tr><td align="left">endereco_completo</td></tr><tr><td align="left">login</td></tr><tr><td align="left">senha_hash</td></tr><tr><td align="left">perfil (master/comum/funcionario)</td></tr><tr><td align="left">data_cadastro</td></tr></table>>];
usuario_permissao [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" bgcolor="#FFF7E3" color="#333333"><tr><td bgcolor="#F2A900" align="center"><font color="black"><b>USUARIO_PERMISSAO</b></font></td></tr><tr><td align="left"><b>id_usuario (PK,FK)</b></td></tr><tr><td align="left"><b>modulo (PK)</b></td></tr><tr><td align="left">pode_ver</td></tr><tr><td align="left">pode_incluir</td></tr><tr><td align="left">pode_alterar</td></tr><tr><td align="left">pode_excluir</td></tr></table>>];
canal_venda -> pedido [xlabel="1,1 : 0,N"];
usuario -> pedido [xlabel="0,1 : 0,N"];
entregador -> pedido [xlabel="0,1 : 0,N"];
mesa -> pedido [xlabel="0,1 : 0,N"];
pedido -> conta_financeira [xlabel="0,1 : 0,N"];
usuario -> conta_financeira [xlabel="0,1 : 0,N"];
usuario -> autenticacao_2fa [xlabel="1,1 : 0,N"];
usuario -> usuario_permissao [xlabel="1,1 : 0,N"];
insumo -> produto_insumo [xlabel="1,1 : 0,N"];
produto -> produto_insumo [xlabel="1,1 : 0,N"];
pedido -> notificacao_cliente [xlabel="1,1 : 0,N"];
usuario -> fechamento_caixa [xlabel="0,1 : 0,N"];
categoria -> produto [xlabel="1,1 : 0,N"];
insumo -> movimento_estoque [xlabel="1,1 : 0,N"];
usuario -> movimento_estoque [xlabel="0,1 : 0,N"];
forma_pagamento -> pagamento [xlabel="1,1 : 0,N"];
pedido -> pagamento [xlabel="1,1 : 0,N"];
pedido -> item_pedido [xlabel="1,1 : 0,N"];
produto -> item_pedido [xlabel="1,1 : 0,N"];
usuario -> log_acesso [xlabel="1,1 : 0,N"];
{rank=same; usuario; categoria; canal_venda; forma_pagamento;}
}